# Trip2Go messaging server — copy to .env and fill in. Never commit .env.
MESSAGING_HOST=127.0.0.1
MESSAGING_PORT=8787

# Meta app (developers.facebook.com → your app → Settings → Basic)
META_APP_SECRET=
# Any random string; enter the same value when registering the webhook in the Meta app dashboard
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# One entry per company. pageToken = long-lived, business-owned Page access token.
# igUserId = Instagram professional account linked to that Page (omit if Instagram is not connected).
# META_ACCOUNTS=[{"companyId":"flightnest","pageId":"","pageToken":"","igUserId":""}]
META_ACCOUNTS=
